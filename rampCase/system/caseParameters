FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      caseParameters;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
//
//  Single source of truth for the ramp case.
//  Included by blockMeshDict, thermophysicalProperties and 0/{p,T,U}.
//  Also parsed by scripts/postprocess.py for the analytical comparison.
//
//                         top (supersonic far field)
//      +-----------------------------------------------------------+
//      |                                                           |
//   M  |                                                           |  outlet
//  --> |                          shoulder                         |
//      |                       ___________________________________ |
//      |                  ___/  (Prandtl-Meyer expansion fan)      |
//      |_____________ ___/  ramp, angle = rampAngle                |
//      upstream     corner  (oblique shock)
//      |<- xUp ->|<-rampLength->|<---------- xDown ---------->|
//

// ---- Freestream ------------------------------------------------------------
Mach            2.4;        // freestream Mach number [-] (AE339 group value)
pInf            101325;     // freestream static pressure [Pa]
TInf            300;        // freestream static temperature [K]

// ---- Gas (calorically perfect air) -----------------------------------------
gamma           1.4;        // ratio of specific heats [-]
R               287.1;      // specific gas constant [J/(kg K)]

// ---- Geometry [m] -----------------------------------------------------------
rampAngle       15;         // ramp deflection angle [deg]
xUp             0.25;       // flat wall upstream of the ramp corner
rampLength      0.5;        // horizontal extent of the ramp
xDown           1.5;        // flat wall downstream of the shoulder
height          1.25;       // domain height above the corner

// ---- Mesh ------------------------------------------------------------------
cellSize        0.005;      // target uniform cell size [m]

// ************************************************************************* //
