#!/bin/sh
#------------------------------------------------------------------------------
# Inviscid supersonic flow over a compression ramp (rhoCentralFoam).
# Flow and geometry are set in system/caseParameters.
#
# Run inside an OpenFOAM environment, from a path WITHOUT spaces
# (see ../run.sh). Core count: numberOfSubdomains in system/decomposeParDict.
#------------------------------------------------------------------------------
cd "${0%/*}" || exit 1
. ${WM_PROJECT_DIR:?}/bin/tools/RunFunctions

app="$(getApplication)"
nProcs="$(getNumberOfProcessors)"

restore0Dir

runApplication blockMesh
runApplication checkMesh

if [ "$nProcs" -gt 1 ]
then
    runApplication decomposePar
    # mpirun starts each rank in the physical directory; exporting PWD keeps
    # the logical (symlinked, space-free) path, since OpenFOAM rejects spaces.
    echo "Running $app ($nProcs processes) on $PWD"
    mpirun -x PWD -np "$nProcs" "$app" -parallel < /dev/null > log."$app" 2>&1
    runApplication reconstructPar
    rm -rf processor*
else
    runApplication "$app"
fi

# Cell centres and density gradient (numerical schlieren) for post-processing
runApplication -s cellCentres postProcess -func writeCellCentres -latestTime
runApplication -s gradRho postProcess -func "grad(rho)" -latestTime

# Stub file for ParaView
touch rampCase.foam

#------------------------------------------------------------------------------
